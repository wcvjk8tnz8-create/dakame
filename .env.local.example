# ---- 认证（自研：GitHub OAuth2 + 邮箱验证码，无 Clerk）----
# 任意 32 位随机字符串：openssl rand -hex 32
AUTH_SECRET=
# 站点地址，OAuth 回调会用到；Vercel 上可留空（自动用 VERCEL_URL）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- GitHub OAuth2 ----
# 创建地址：https://github.com/settings/developers → New OAuth App
# Homepage URL:               http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- 邮箱验证码登录（Resend，可选）----
# 不配也能跑：开发环境验证码会打印到服务端控制台
RESEND_API_KEY=
EMAIL_FROM=打卡么 <no-reply@your-domain.com>

# ---- Upstash Redis（数据层）----
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ---- AI 提供商（默认 Cloudflare Workers AI）----
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# 可选：切换到其他提供商
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- 应用 ----
# 打卡日期以该时区为准（默认香港/上海时间）
APP_TIMEZONE=Asia/Shanghai
# 固定服务端时区为 UTC，保证 date-fns 计算不漂移
TZ=UTC
# 捐助页外链
NEXT_PUBLIC_SPONSOR_URL=https://xxx.com/sponsor
